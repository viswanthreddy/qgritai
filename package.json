{
  "name": "qgritai",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @qgritai/web dev",
    "build": "pnpm --filter @qgritai/web build",
    "lint": "pnpm --filter @qgritai/web lint",
    "typecheck": "pnpm --filter @qgritai/web typecheck",
    "test": "pnpm --filter @qgritai/web test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning"
  },
  "devDependencies": {
    "supabase": "2.110.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<=8.5.17": "8.5.25",
      "sharp@<0.35.0": "0.35.3"
    }
  }
}
