# Exact canonical URL. Set this for Vercel Production; previews fall back to NEXT_PUBLIC_VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Values from Supabase Project Settings > API. The publishable/anon key is intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Server-only notification delivery values. Do not prefix these with NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
RESEND_API_KEY=replace-with-email-provider-key
EMAIL_FROM=QgritAI <notifications@example.com>
CONTACT_NOTIFICATION_TO=hello@example.com
CRON_SECRET=replace-with-at-least-16-random-characters
# Careers: public Turnstile site key plus server-only secret, inbox, and temporary-upload signing secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
CAREERS_NOTIFICATION_TO=info@qgritai.com
CAREERS_UPLOAD_SIGNING_SECRET=replace-with-at-least-32-random-characters
DOCUMENT_SCANNER_URL=https://scanner.example.com/scan
DOCUMENT_SCANNER_SECRET=replace-with-at-least-16-random-characters
